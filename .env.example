# Copy to .env and fill in. Only needed to run a LIVE lab (efferents start).
# The offline demo (`efferents demo smoke-lab`) needs none of these.

# Event profile: use Z.ai's full GLM-5.3 by default.
# Set these in each submission's .env; keys stay in the lab daemon.
EFFERENTS_MODEL=zai/glm-5.3
ANTHROPIC_API_KEY=
ZAI_API_KEY=
# With Anthropic credits: EFFERENTS_MODEL=claude-sonnet-5,zai/glm-5.3

# Or select any model supported by LiteLLM and provide that provider's key.
# Examples: openai/gpt-5, gemini/gemini-2.5-pro, groq/llama-3.3-70b-versatile,
# openrouter/anthropic/claude-sonnet-4, ollama/llama3.3.
# EFFERENTS_MODEL=openai/gpt-5
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Optional role-specific overrides and OpenAI-compatible endpoint.
# EFFERENTS_MODEL_CODER=openai/gpt-5
# EFFERENTS_API_BASE=http://localhost:11434/v1

# ── Multi-provider failover chains ─────────────────────────────────────────
# Any EFFERENTS_MODEL* value accepts a comma-separated chain. The first entry
# is the preferred model; on a provider error (quota exhausted, auth failure,
# outage) or missing credentials the call falls through to the next entry.
# Toggle any combination by editing the chains — set the keys you have, and
# candidates without keys are skipped automatically.
#
# All roles inherit EFFERENTS_MODEL unless explicitly overridden. Keep the
# GLM fallback in any role override that needs the same event policy.
# EFFERENTS_MODEL_CODER=claude-opus-4-8,zai/glm-5.3
# MOONSHOT_API_KEY=

# Optional: path to the popper-probe checkout used by the falsifiability gate.
# Defaults to ~/Documents/popper-probe if unset.
# POPPER_PROBE_REPO=

# Optional: ntfy.sh topic for run notifications.
# NTFY_TOPIC=

# Optional: root directory for the lab registry and repository checkouts.
# Defaults to ~/.efferents if unset.
# EFFERENTS_HOME=
