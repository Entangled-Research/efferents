# Copy to .env next to compose.yaml and fill every required value.
# A hostname only: no https:// prefix, port, or path. Point its A record at
# the Droplet first. A public-IP.sslip.io hostname also works for a first link.
EFFERENTS_HOSTNAME=
EFFERENTS_AUTH_USER=organizer

# Generate interactively: docker run --rm -it caddy:2-alpine caddy hash-password
# Paste the output BETWEEN the single quotes below; keep every dollar sign.
# This is a password hash, never the password itself.
EFFERENTS_AUTH_HASH=''

# Private event identity and lifecycle. Generate both secrets with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
EVENT_ID=autoresearch-night-2026-09
EVENT_ENROLLMENT_CODE=
EVENT_ADMIN_KEY=
EVENT_EXPIRES_AT=2026-09-25T00:00:00+00:00

# Event-side hard limits. Participants retain a second local limit in lab.yaml.
EVENT_TOKEN_CAP_USD=3.0
EVENT_TOTAL_CAP_USD=50.0
EVENT_REQUESTS_PER_MINUTE=30
EVENT_STALE_AFTER_SECONDS=180
EVENT_MAX_OUTPUT_TOKENS=16384

# Azure OpenAI v1 endpoint and resource key. Keep the key in this mode-600
# file only; never put it in participant labs, the gateway, Git, or commands.
# Deploy GPT-4.1 nano (FAST), GPT-5.6 Luna (STANDARD), and GPT-5.6 Sol
# (DEEP). Use your exact deployment names and region/deployment-type
# pay-as-you-go prices; these are not OpenAI-platform prices.
EVENT_AZURE_OPENAI_BASE=https://YOUR-RESOURCE.openai.azure.com/openai/v1
EVENT_AZURE_OPENAI_API_KEY=
EVENT_AZURE_FAST_DEPLOYMENT=
EVENT_AZURE_FAST_INPUT_USD_PER_MTOK=
EVENT_AZURE_FAST_OUTPUT_USD_PER_MTOK=
EVENT_AZURE_STANDARD_DEPLOYMENT=
EVENT_AZURE_STANDARD_INPUT_USD_PER_MTOK=
EVENT_AZURE_STANDARD_OUTPUT_USD_PER_MTOK=
EVENT_AZURE_DEEP_DEPLOYMENT=
EVENT_AZURE_DEEP_INPUT_USD_PER_MTOK=
EVENT_AZURE_DEEP_OUTPUT_USD_PER_MTOK=
